<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cmt</groupId>
    <artifactId>cmt-console-e2e</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <junit-jupiter.version>5.13.4</junit-jupiter.version>
        <assertj.version>3.27.4</assertj.version>
        <xmlunit.version>2.10.3</xmlunit.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <slf4j.version>2.0.17</slf4j.version>
        <logback.version>1.5.19</logback.version>
        <cubrid-jdbc.version>11.3.2.0053</cubrid-jdbc.version>
        <ojdbc8.version>21.9.0.0</ojdbc8.version>
        <mysql-connector-j.version>8.4.0</mysql-connector-j.version>
        <mariadb-java-client.version>3.4.1</mariadb-java-client.version>
        <!-- mssql-jdbc 11.2.3.jre11 keeps the legacy "encrypt=false" default
             that 12.x flipped to "true". CMT 's ScriptCommandHandler reads
             db.conf as Java Properties and does not forward user_jdbc_url
             (the field is XML-only), so we cannot inject encrypt=false at
             the URL level. Sticking with 11.x avoids needing to ship a
             trusted server cert in the test JVM 's truststore. -->
        <mssql-jdbc.version>11.2.3.jre11</mssql-jdbc.version>
        <!-- IBM Informix JDBC. 4.50.x is the long-term support line for
             Informix 12.10 / 14.10 servers; 15.x targets 15.0 servers.
             Class: com.informix.jdbc.IfxDriver. -->
        <informix-jdbc.version>4.50.3</informix-jdbc.version>
        <!-- The flyway-database-cubrid community plugin is only released up to 10.x.
             Keep flyway-core and the plugin on the same version to avoid conflicts. -->
        <flyway.version>10.22.0</flyway.version>
        <!-- Explicit Jackson version that includes @JsonKey required by flyway-database-cubrid -->
        <jackson.version>2.16.2</jackson.version>

        <!-- Default main class for `mvn exec:java`; override at command line for
             ad-hoc developer scripts (see exec-maven-plugin block below). -->
        <exec.mainClass>com.cmt.e2e.scripts.RegenerateScripts</exec.mainClass>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.xmlunit</groupId>
            <artifactId>xmlunit-assertj</artifactId>
            <version>${xmlunit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Oracle Testcontainers module (supports the gvenzl/oracle-xe image) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>oracle-xe</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Oracle JDBC driver: backward compatible with 11g and later -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc8</artifactId>
            <version>${ojdbc8.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- MySQL JDBC driver. Connector/J 8.4.x supports MySQL 5.7 / 8.0 / 8.4 servers
             and registers the SPI so Flyway recognizes jdbc:mysql: URLs without a
             separate flyway-mysql plugin (Connector/J ships its own SPI). -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql-connector-j.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- MariaDB JDBC driver. mariadb-java-client 3.x talks both MariaDB and
             MySQL servers and registers jdbc:mariadb: SPI for Flyway. -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>${mariadb-java-client.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Flyway MySQL community plugin: registers Flyway database support for
             MySQL/MariaDB so DatabaseInitializer can run jdbc:mysql: / jdbc:mariadb:
             migrations. flyway-mysql autodetects MariaDB via JDBC metadata. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <version>${flyway.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Microsoft SQL Server JDBC driver. Class
             com.microsoft.sqlserver.jdbc.SQLServerDriver. -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <version>${mssql-jdbc.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Flyway SQL Server community plugin: registers Flyway database
             support for jdbc:sqlserver: URLs and parses GO batch separators. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-sqlserver</artifactId>
            <version>${flyway.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- IBM Informix JDBC driver. Class com.informix.jdbc.IfxDriver. -->
        <dependency>
            <groupId>com.ibm.informix</groupId>
            <artifactId>jdbc</artifactId>
            <version>${informix-jdbc.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Tibero JDBC driver lives in the `tibero` profile (below) —
             not on Maven Central, license-restricted by TmaxSoft, jar is
             dev-private (see tests/e2e/tibero/README.md). When the jar
             is present at ${project.basedir}/lib/tibero7-jdbc-17.jar
             the profile auto-activates; otherwise Tibero @Test methods
             skip via @EnabledIf and the rest of the build proceeds. -->

        <!-- Flyway Informix community plugin: registers the
             DatabaseType for jdbc:informix-sqli: URLs via the
             ServiceLoader-based discovery mechanism in flyway-core 10.x.
             Without this, Flyway raises "No database found to handle ..."
             when the initializer connects. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-informix</artifactId>
            <version>${flyway.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.cubrid</groupId>
            <artifactId>cubrid-jdbc</artifactId>
            <version>${cubrid-jdbc.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- CUBRID community plugin: registers the SPI so Flyway recognizes jdbc:cubrid: URLs -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-cubrid</artifactId>
            <version>${flyway.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Oracle community plugin: registers the SPI so Flyway recognizes jdbc:oracle: URLs -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-oracle</artifactId>
            <version>${flyway.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- @JsonKey used by flyway-database-cubrid was introduced in Jackson 2.16.
             flyway-core pulls 2.15.x transitively, so override it explicitly. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-cubrid-jdbc-driver</id>
                        <phase>generate-test-resources</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.cubrid</groupId>
                                    <artifactId>cubrid-jdbc</artifactId>
                                    <version>${cubrid-jdbc.version}</version>
                                    <outputDirectory>${project.build.testOutputDirectory}/driver</outputDirectory>
                                    <destFileName>cubrid-jdbc-${cubrid-jdbc.version}.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-oracle-jdbc-driver</id>
                        <phase>generate-test-resources</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.oracle.database.jdbc</groupId>
                                    <artifactId>ojdbc8</artifactId>
                                    <version>${ojdbc8.version}</version>
                                    <outputDirectory>${project.build.testOutputDirectory}/driver</outputDirectory>
                                    <destFileName>ojdbc8-${ojdbc8.version}.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-mysql-jdbc-driver</id>
                        <phase>generate-test-resources</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.mysql</groupId>
                                    <artifactId>mysql-connector-j</artifactId>
                                    <version>${mysql-connector-j.version}</version>
                                    <outputDirectory>${project.build.testOutputDirectory}/driver</outputDirectory>
                                    <destFileName>mysql-connector-j-${mysql-connector-j.version}.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-mariadb-jdbc-driver</id>
                        <phase>generate-test-resources</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.mariadb.jdbc</groupId>
                                    <artifactId>mariadb-java-client</artifactId>
                                    <version>${mariadb-java-client.version}</version>
                                    <outputDirectory>${project.build.testOutputDirectory}/driver</outputDirectory>
                                    <destFileName>mariadb-java-client-${mariadb-java-client.version}.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-mssql-jdbc-driver</id>
                        <phase>generate-test-resources</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.microsoft.sqlserver</groupId>
                                    <artifactId>mssql-jdbc</artifactId>
                                    <version>${mssql-jdbc.version}</version>
                                    <outputDirectory>${project.build.testOutputDirectory}/driver</outputDirectory>
                                    <destFileName>mssql-jdbc-${mssql-jdbc.version}.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-informix-jdbc-driver</id>
                        <phase>generate-test-resources</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <!-- IBM Informix JDBC artifact. The default jar
                                         name is just "jdbc-X.Y.Z.jar" (groupId-only
                                         artifactId), which collides with other JDBC
                                         drivers in the same dir. Rename via
                                         destFileName so Drivers.java can match an
                                         Informix-specific glob. -->
                                    <groupId>com.ibm.informix</groupId>
                                    <artifactId>jdbc</artifactId>
                                    <version>${informix-jdbc.version}</version>
                                    <outputDirectory>${project.build.testOutputDirectory}/driver</outputDirectory>
                                    <destFileName>informix-jdbc-${informix-jdbc.version}.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Tibero JDBC jar handling lives in the `tibero` profile below.
                 Profile auto-activates when the jar is present locally; the
                 default build (without the jar) compiles fine because Tibero
                 source files use only java.sql + Class.forName via @EnabledIf,
                 with no static reference to the proprietary driver class. -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <!-- Keep console output on Surefire defaults and trim noisy stack traces.
                         Detailed diagnostics stay in per-test logs and surefire XML/TXT reports. -->
                    <trimStackTrace>true</trimStackTrace>
                </configuration>
            </plugin>

            <!--
                Exec helper for developer scripts that are not part of the test
                lifecycle. Default main class is RegenerateScripts (driven by
                bin/regenerate-scripts.sh). Override on the command line for
                ad-hoc developer scripts under com.cmt.e2e.scripts:
                    mvn exec:java -Dexec.mainClass=com.cmt.e2e.scripts.SomeUtility
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                    <classpathScope>test</classpathScope>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- =================================================================
         Profile: tibero
         Auto-activated when the proprietary TmaxSoft JDBC jar is present
         at lib/tibero7-jdbc-17.jar. When absent (e.g. public clone), the
         profile stays inactive: the dependency is not declared, the jar
         is not copied to driver/, and Tibero @Test methods skip via
         @EnabledIf("...TiberoEnvironment#isAvailable") at runtime. The
         non-Tibero build remains green.
         ================================================================= -->
    <profiles>
        <profile>
            <id>tibero</id>
            <activation>
                <file>
                    <exists>${project.basedir}/lib/tibero7-jdbc-17.jar</exists>
                </file>
            </activation>

            <dependencies>
                <!-- TmaxSoft Tibero JDBC. Class com.tmax.tibero.jdbc.TbDriver.
                     Not on Maven Central; jar is dev-private — see
                     tests/e2e/tibero/README.md for setup. system scope is
                     deprecated in modern Maven but acceptable here because
                     this profile is gated by the jar's local existence and
                     the artifact is test-only. -->
                <dependency>
                    <groupId>com.tmax.tibero</groupId>
                    <artifactId>tibero7-jdbc</artifactId>
                    <version>17</version>
                    <scope>system</scope>
                    <systemPath>${project.basedir}/lib/tibero7-jdbc-17.jar</systemPath>
                </dependency>
            </dependencies>

            <build>
                <plugins>
                    <!-- Copy the local jar into the same driver directory
                         maven-dependency-plugin uses for Maven-Central drivers,
                         so JdbcDriverJars.latest(DB.TIBERO) discovers it
                         without special-casing. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-tibero-jdbc-driver</id>
                                <phase>generate-test-resources</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.testOutputDirectory}/driver</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/lib</directory>
                                            <includes>
                                                <include>tibero7-jdbc-*.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
