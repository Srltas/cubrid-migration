CREATE TABLE [ROOT].[e2e_binary_types](
[id] int,
[binary_col] bit(64),
[varbinary_col] bit varying(512),
[bit_col] bit(64),
[blob_col] bit varying(4194240),
[longblob_col] bit varying(1073741823)
)
;
CREATE TABLE [ROOT].[e2e_customer](
[customer_id] int AUTO_INCREMENT (5,1),
[customer_code] char(4) NOT NULL COMMENT 'business key',
[customer_name] varchar(100) NOT NULL,
[customer_alias] varchar(60) COMMENT '고객 별칭 (다국어 검증)',
[status] char(1),
[credit_limit] numeric(15,2),
[created_on] datetime,
[updated_on] datetime
)
;
CREATE TABLE [ROOT].[e2e_employee](
[employee_id] int,
[manager_id] int COMMENT 'Self-FK to direct manager',
[emp_name] varchar(100) NOT NULL,
[hired_on] date
)
;
CREATE TABLE [ROOT].[e2e_mariadb_enum_types](
[id] int,
[status_enum] enum('NEW','HOLD','DONE','CANCEL')
)
;
CREATE TABLE [ROOT].[e2e_mariadb_json_types](
[id] int,
[payload] varchar(1073741823)
)
;
CREATE TABLE [ROOT].[e2e_numeric_types](
[id] int,
[tinyint_col] short,
[smallint_col] short,
[mediumint_col] int,
[int_col] int,
[bigint_col] bigint,
[decimal_col] numeric(20,6),
[decimal_p0_col] numeric(38,0),
[float_col] float,
[double_col] double
)
;
CREATE TABLE [ROOT].[e2e_order](
[order_id] int AUTO_INCREMENT (5,1),
[customer_id] int NOT NULL,
[order_no] varchar(30),
[order_status] varchar(20),
[total_amount] numeric(18,2),
[ordered_at] datetime,
[settled_at] datetime,
[source_comment] varchar(200) COMMENT '주문 비고: 다국어/특수문자 검증'
)
;
CREATE TABLE [ROOT].[e2e_order_line](
[order_id] int,
[line_no] short,
[sku] varchar(30),
[qty] int,
[unit_price] numeric(15,2),
[line_note] varchar(200)
)
;
CREATE TABLE [ROOT].[e2e_temporal_types](
[id] int,
[date_col] date,
[time_col] time,
[datetime_col] datetime,
[timestamp_col] timestamp,
[year_col] char(4)
)
;
CREATE TABLE [ROOT].[e2e_text_types](
[id] int,
[char_col] char(3),
[varchar_col] varchar(10),
[text_col] varchar(65535),
[mediumtext_col] varchar(16277215),
[longtext_col] varchar(1073741823)
)
;
CREATE TABLE [ROOT].[flyway_schema_history](
[installed_rank] int,
[version] varchar(50),
[description] varchar(200) NOT NULL,
[type] varchar(20) NOT NULL,
[script] varchar(1000) NOT NULL,
[checksum] int,
[installed_by] varchar(100) NOT NULL,
[installed_on] timestamp DEFAULT TIMESTAMP'01/02/1970 01:00:00' NOT NULL,
[execution_time] int NOT NULL,
[success] short NOT NULL
)
;
