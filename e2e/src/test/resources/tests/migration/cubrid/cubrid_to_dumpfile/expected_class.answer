CREATE TABLE [PUBLIC].[athlete](
[code] int AUTO_INCREMENT (16694,1),
[name] varchar(40) NOT NULL,
[gender] char(1),
[nation_code] char(3),
[event] varchar(30)
) REUSE_OID
;
CREATE TABLE [PUBLIC].[code](
[s_name] char(1),
[f_name] varchar(6)
) REUSE_OID
;
CREATE TABLE [PUBLIC].[event](
[code] int,
[sports] varchar(50),
[name] varchar(50),
[gender] char(1),
[players] int
) REUSE_OID
;
CREATE TABLE [PUBLIC].[game](
[host_year] int,
[event_code] int,
[athlete_code] int,
[stadium_code] int NOT NULL,
[nation_code] char(3),
[medal] char(1),
[game_date] date
) REUSE_OID
;
CREATE TABLE [PUBLIC].[history](
[event_code] int,
[athlete] varchar(40),
[host_year] int,
[score] varchar(10),
[unit] varchar(5)
) REUSE_OID
;
CREATE TABLE [PUBLIC].[nation](
[code] char(3),
[name] varchar(40) NOT NULL,
[continent] varchar(10),
[capital] varchar(30)
) REUSE_OID
;
CREATE TABLE [PUBLIC].[olympic](
[host_year] int,
[host_nation] varchar(40) NOT NULL,
[host_city] varchar(20) NOT NULL,
[opening_date] date NOT NULL,
[closing_date] date NOT NULL,
[mascot] varchar(20),
[slogan] varchar(40),
[introduction] varchar(1500)
) REUSE_OID
;
CREATE TABLE [PUBLIC].[participant](
[host_year] int,
[nation_code] char(3),
[gold] int DEFAULT 0,
[silver] int DEFAULT 0,
[bronze] int DEFAULT 0
) REUSE_OID
;
CREATE TABLE [PUBLIC].[record](
[host_year] int,
[event_code] int,
[athlete_code] int,
[medal] char(1),
[score] varchar(20),
[unit] varchar(5)
) REUSE_OID
;
CREATE TABLE [PUBLIC].[stadium](
[code] int,
[nation_code] char(3) NOT NULL,
[name] varchar(50) NOT NULL,
[area] numeric(10,2),
[seats] int,
[address] varchar(100)
) REUSE_OID
;
